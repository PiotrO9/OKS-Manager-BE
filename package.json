{
	"name": "osk-manager-be",
	"version": "0.1.0",
	"private": true,
	"main": "dist/server.js",
	"engines": {
		"node": ">=24.11 <25",
		"npm": ">=11 <12"
	},
	"scripts": {
		"postinstall": "prisma generate",
		"dev": "tsx watch src/server.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/server.js",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev --name init",
		"prisma:studio": "prisma studio",
		"lint": "eslint src --max-warnings=0",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write \"src/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:build": "tsc -p tsconfig.build.json --noEmit",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
		"test": "vitest run",
		"test:integration": "node scripts/run-integration-tests.mjs",
		"audit:schedule-times": "node scripts/audit-schedule-times.mjs",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@internationalized/date": "^3.12.4",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@supabase/supabase-js": "^2.118.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.8",
		"express": "^5.3.0",
		"jose": "^6.2.13",
		"multer": "^2.4.0",
		"pg": "^8.23.1",
		"swagger-ui-express": "^5.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^24.19.2",
		"@types/swagger-ui-express": "^4.1.8",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"@vitest/coverage-v8": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prisma": "^7.10.1",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	}
}
