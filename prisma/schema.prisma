generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  MANAGER
  ADMIN
}

enum LessonType {
  THEORY
  PRACTICE
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentPlanType {
  FULL
  INSTALLMENTS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CourseKind {
  THEORY_GROUP
  PRACTICAL
  EXTRA
}

enum CourseParticipantStatus {
  ACTIVE
  FINISHED
}

enum VehicleAvailabilityStatus {
  ACTIVE
  UNAVAILABLE
}

enum InstructorTimeBlockType {
  BREAK
  MEETING
  OTHER
}

enum EventType {
  DRIVE
  THEORY
}

enum EventStatus {
  PLANNED
  DONE
  NO_SHOW
  CANCELLED
}

// NOTE: DB-level constraints (EXCLUDE, CHECK) must be added as raw SQL migrations.
// See context/db_constraints.md for recommended SQL snippets.

model User {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique @map("email")
  phone     String?   @map("phone")
  role      Role      @map("role")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  defaultOskId String? @map("default_osk_id") @db.Uuid

  settings            UserSettings?
  profile             UserProfile?
  instructorProfile   InstructorProfile?
  studentProfile      StudentProfile?
  drivingSchoolsOwned DrivingSchool[]    @relation("OwnerDrivingSchools")
  defaultOsk          DrivingSchool?     @relation("DefaultOSK", fields: [defaultOskId], references: [id])
  accountSessions     AccountSession[]
  accountActionsMade  AccountAction[]    @relation("AccountActionActor")
  accountActionsFor   AccountAction[]    @relation("AccountActionTarget")

  @@index([role], name: "idx_users_role")
  @@map("users")
}

model UserSettings {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  themeMode String?   @default("light") @map("theme_mode")
  language  String?   @default("pl")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserProfile {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  avatarUrl String?  @map("avatar_url")
  bio       String?  @map("bio")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model DrivingSchool {
  id               String    @id @default(uuid()) @map("id") @db.Uuid
  name             String    @map("name")
  city             String?   @map("city")
  address          String?   @map("address")
  ownerId          String    @map("owner_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")
  defaultVehicleId String?   @map("default_vehicle_id") @db.Uuid

  owner                User                  @relation("OwnerDrivingSchools", fields: [ownerId], references: [id])
  defaultVehicle       Vehicle?              @relation("SchoolDefaultVehicle", fields: [defaultVehicleId], references: [id], onDelete: SetNull)
  defaultForUsers      User[]                @relation("DefaultOSK")
  settings             SchoolSettings?
  vehicles             Vehicle[]
  courses              Course[]
  instructorSchools    InstructorSchool[]
  studentSchools       StudentSchool[]
  instructorTimeBlocks InstructorTimeBlock[]
  instructorEvents     InstructorEvent[]

  @@map("driving_schools")
}

model AccountSession {
  sessionId String    @id @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], name: "idx_account_sessions_user_revoked")
  @@map("account_sessions")
}

model AccountAction {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  action    String
  status    String
  oldValue  String?  @map("old_value")
  newValue  String?  @map("new_value")
  requestId String?  @map("request_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  actor  User @relation("AccountActionActor", fields: [actorId], references: [id])
  target User @relation("AccountActionTarget", fields: [targetId], references: [id])

  @@index([targetId, status], name: "idx_account_actions_target_status")
  @@index([schoolId, createdAt], name: "idx_account_actions_school_created")
  @@map("account_actions")
}

// Security history deliberately has no foreign keys to users/schools: removing an
// account or a school must not silently rewrite or erase historical evidence.
model SecurityEvent {
  id                        String                @id @default(uuid()) @db.Uuid
  occurredAt                DateTime              @default(now()) @map("occurred_at") @db.Timestamptz(3)
  recordedAt                DateTime              @default(now()) @map("recorded_at") @db.Timestamptz(3)
  type                      String                @db.VarChar(64)
  category                  String                @db.VarChar(32)
  severity                  String                @db.VarChar(16)
  outcome                   String                @db.VarChar(16)
  reasonCode                String?               @map("reason_code") @db.VarChar(64)
  operationCode             String?               @map("operation_code") @db.VarChar(96)
  operationLabelSnapshot    String?               @map("operation_label_snapshot") @db.VarChar(160)
  httpMethod                String?               @map("http_method") @db.VarChar(8)
  routeTemplate             String?               @map("route_template") @db.VarChar(180)
  httpStatus                Int?                  @map("http_status")
  actorUserId               String?               @map("actor_user_id") @db.Uuid
  actorRoleSnapshot         String?               @map("actor_role_snapshot") @db.VarChar(24)
  actorDisplayNameSnapshot  String?               @map("actor_display_name_snapshot") @db.VarChar(160)
  targetUserId              String?               @map("target_user_id") @db.Uuid
  targetDisplayNameSnapshot String?               @map("target_display_name_snapshot") @db.VarChar(160)
  resourceType              String?               @map("resource_type") @db.VarChar(48)
  resourceId                String?               @map("resource_id") @db.VarChar(100)
  loginIdentifierHash       String?               @map("login_identifier_hash") @db.VarChar(64)
  hashKeyVersion            String?               @map("hash_key_version") @db.VarChar(24)
  loginIdentifierMasked     String?               @map("login_identifier_masked") @db.VarChar(100)
  clientIp                  String?               @map("client_ip") @db.VarChar(45)
  ipSource                  String?               @map("ip_source") @db.VarChar(24)
  userAgent                 String?               @map("user_agent") @db.VarChar(256)
  requestId                 String?               @map("request_id") @db.VarChar(100)
  attemptId                 String                @map("attempt_id") @db.VarChar(100)
  eventPhase                String                @default("RESULT") @map("event_phase") @db.VarChar(48)
  source                    String                @db.VarChar(32)
  sourceEventId             String?               @map("source_event_id") @db.VarChar(100)
  accountActionId           String?               @map("account_action_id") @db.Uuid
  metadata                  Json                  @default("{}")
  schools                   SecurityEventSchool[]

  @@unique([source, attemptId, eventPhase], name: "uq_security_events_source_attempt_phase")
  @@index([occurredAt(sort: Desc), id(sort: Desc)], name: "idx_security_events_time")
  @@index([type, occurredAt(sort: Desc)], name: "idx_security_events_type_time")
  @@index([loginIdentifierHash, occurredAt(sort: Desc)], name: "idx_security_events_login_time")
  @@index([clientIp, occurredAt(sort: Desc)], name: "idx_security_events_ip_time")
  @@map("security_events")
}

model SecurityEventSchool {
  eventId           String        @map("event_id") @db.Uuid
  schoolId          String        @map("school_id") @db.Uuid
  occurredAt        DateTime      @map("occurred_at") @db.Timestamptz(3)
  viewerUserId      String?       @map("viewer_user_id") @db.Uuid
  actorVisibility   String        @map("actor_visibility") @db.VarChar(12)
  actorUserId       String?       @map("actor_user_id") @db.Uuid
  actorDisplayName  String?       @map("actor_display_name") @db.VarChar(160)
  actorRole         String?       @map("actor_role") @db.VarChar(24)
  targetUserId      String?       @map("target_user_id") @db.Uuid
  targetDisplayName String?       @map("target_display_name") @db.VarChar(160)
  event             SecurityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, schoolId])
  @@index([schoolId, occurredAt(sort: Desc), eventId(sort: Desc)], name: "idx_security_event_schools_list")
  @@index([schoolId, actorUserId], name: "idx_security_event_schools_actor")
  @@index([schoolId, targetUserId], name: "idx_security_event_schools_target")
  @@map("security_event_schools")
}

model SecurityDetectionState {
  rule                 String    @db.VarChar(24)
  scopeKey             String    @map("scope_key") @db.VarChar(100)
  subjectKey           String    @map("subject_key") @db.VarChar(100)
  keyVersion           String    @map("key_version") @db.VarChar(24)
  queuedGeneration     Int       @default(0) @map("queued_generation")
  doneGeneration       Int       @default(0) @map("done_generation")
  nextEligibleAt       DateTime? @map("next_eligible_at") @db.Timestamptz(3)
  lastProcessedAt      DateTime? @map("last_processed_at") @db.Timestamptz(3)
  lastProcessedEventId String?   @map("last_processed_event_id") @db.Uuid
  lastActiveAt         DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(3)

  @@id([rule, scopeKey, subjectKey, keyVersion])
  @@index([doneGeneration, queuedGeneration, lastActiveAt], name: "idx_security_detection_pending")
  @@map("security_detection_states")
}

model SchoolSettings {
  id                              String       @id @default(uuid()) @map("id") @db.Uuid
  schoolId                        String       @unique @map("school_id") @db.Uuid
  workingDaysMask                 Int          @default(62) @map("working_days_mask")
  workingHoursStart               DateTime     @default(dbgenerated("'08:00'::time")) @map("working_hours_start") @db.Time
  workingHoursEnd                 DateTime     @default(dbgenerated("'18:00'::time")) @map("working_hours_end") @db.Time
  slotDurationMinutes             Int          @default(60) @map("slot_duration_minutes")
  slotMustStartFullHour           Boolean      @default(true) @map("slot_must_start_full_hour")
  practiceMinDurationMinutes      Int          @default(60) @map("practice_min_duration_minutes")
  practiceMaxDurationMinutes      Int          @default(120) @map("practice_max_duration_minutes")
  allowShortFinalPracticeLesson   Boolean      @default(true) @map("allow_short_final_practice_lesson")
  minFinalPracticeDurationMinutes Int          @default(30) @map("min_final_practice_duration_minutes")
  theoryMinDurationMinutes        Int          @default(45) @map("theory_min_duration_minutes")
  theoryMaxDurationMinutes        Int          @default(90) @map("theory_max_duration_minutes")
  bookingMaxDaysAhead             Int          @default(30) @map("booking_max_days_ahead")
  enabledCourseKinds              CourseKind[] @default([]) @map("enabled_course_kinds")
  createdAt                       DateTime     @default(now()) @map("created_at")
  updatedAt                       DateTime?    @map("updated_at")

  school             DrivingSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offeredCourseTypes CourseType[]  @relation("SchoolSettingsOfferedCourseTypes")

  @@map("school_settings")
}

model InstructorProfile {
  id              String    @id @default(uuid()) @map("id") @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  licenseNumber   String    @map("license_number")
  birthDate       DateTime? @map("birth_date") @db.Date
  experienceYears Int?      @map("experience_years")
  qualifications  String?   @map("qualifications") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")

  user                 User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructorSchools    InstructorSchool[]
  workingHoursDefault  InstructorWorkingHoursDefault[]
  workingHours         InstructorWorkingHours[]
  timeBlocks           InstructorTimeBlock[]
  leaves               InstructorLeave[]
  lessons              Lesson[]                        @relation("InstructorLessons")
  lessonRatings        LessonRating[]                  @relation("InstructorLessonRatings")
  assignedCourses      Course[]                        @relation("CourseAssignedInstructor")
  instructorEvents     InstructorEvent[]               @relation("InstructorEvents")
  qualifiedCourseTypes CourseType[]                    @relation("InstructorQualifiedCourseTypes")

  @@map("instructor_profiles")
}

model StudentProfile {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  pesel     String?  @unique @map("pesel")
  pkkNumber String?  @unique @map("pkk_number") @db.VarChar(20)
  notes     String?  @map("notes")
  createdAt DateTime @default(now()) @map("created_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentSchools     StudentSchool[]
  courseParticipants CourseParticipant[]
  lessons            Lesson[]            @relation("StudentLessons")
  lessonRatings      LessonRating[]      @relation("StudentLessonRatings")
  eventParticipants  EventParticipant[]

  @@map("student_profiles")
}

model InstructorSchool {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  school     DrivingSchool     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([instructorId], name: "uq_instructor_schools_instructor_id")
  @@unique([instructorId, schoolId], name: "uq_instructor_schools_instructor_id_school_id")
  @@map("instructor_schools")
}

model StudentSchool {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school  DrivingSchool  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId], name: "uq_student_schools_student_id")
  @@unique([studentId, schoolId], name: "uq_student_schools_student_id_school_id")
  @@map("student_schools")
}

model Vehicle {
  id                 String                    @id @default(uuid()) @map("id") @db.Uuid
  schoolId           String                    @map("school_id") @db.Uuid
  name               String                    @map("name")
  registrationNumber String                    @map("registration_number")
  inspectionDate     DateTime?                 @map("inspection_date")
  insuranceDate      DateTime?                 @map("insurance_date")
  brand              String?                   @map("brand")
  model              String?                   @map("model")
  photoUrl           String?                   @map("photo_url")
  modelYear          Int?                      @map("model_year")
  mileageKm          Int?                      @map("mileage_km")
  note               String?                   @map("note") @db.Text
  availabilityStatus VehicleAvailabilityStatus @default(ACTIVE) @map("availability_status")
  unavailableUntil   DateTime?                 @map("unavailable_until") @db.Date
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime?                 @map("updated_at") @db.Timestamptz(3)

  school            DrivingSchool     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  defaultForSchools DrivingSchool[]   @relation("SchoolDefaultVehicle")
  lessons           Lesson[]          @relation("VehicleLessons")
  instructorEvents  InstructorEvent[] @relation("VehicleEvents")

  @@unique([schoolId, registrationNumber], name: "uq_vehicles_school_id_registration_number")
  @@map("vehicles")
}

model CourseType {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  code      String   @unique @map("code")
  name      String   @map("name")
  createdAt DateTime @default(now()) @map("created_at")

  schoolSettingsOffered SchoolSettings[]    @relation("SchoolSettingsOfferedCourseTypes")
  qualifiedInstructors  InstructorProfile[] @relation("InstructorQualifiedCourseTypes")
  courses               Course[]

  @@map("course_types")
}

model Course {
  id              String     @id @default(uuid()) @map("id") @db.Uuid
  schoolId        String     @map("school_id") @db.Uuid
  name            String     @map("name")
  category        String     @map("category")
  courseTypeId    String     @map("course_type_id") @db.Uuid
  kind            CourseKind @map("kind")
  totalHours      Int        @map("total_hours")
  capacity        Int?       @map("capacity")
  theoryStartDate DateTime?  @map("theory_start_date") @db.Date
  theoryEndDate   DateTime?  @map("theory_end_date") @db.Date
  instructorId    String?    @map("instructor_id") @db.Uuid
  status          String     @default("active") @map("status")
  createdAt       DateTime   @default(now()) @map("created_at")
  deletedAt       DateTime?  @map("deleted_at")

  school           DrivingSchool       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseType       CourseType          @relation(fields: [courseTypeId], references: [id])
  instructor       InstructorProfile?  @relation("CourseAssignedInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  participants     CourseParticipant[]
  paymentPlans     PaymentPlan[]
  lessons          Lesson[]
  instructorEvents InstructorEvent[]

  @@index([courseTypeId], name: "idx_courses_course_type_id")
  @@map("courses")
}

model CourseParticipant {
  id        String                  @id @default(uuid()) @map("id") @db.Uuid
  courseId  String                  @map("course_id") @db.Uuid
  studentId String                  @map("student_id") @db.Uuid
  status    CourseParticipantStatus @default(ACTIVE) @map("status")
  createdAt DateTime                @default(now()) @map("created_at")

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId], name: "uq_course_participants_course_id_student_id")
  @@index([studentId], name: "idx_course_participants_student_id")
  @@map("course_participants")
}

model Lesson {
  id           String       @id @default(uuid()) @map("id") @db.Uuid
  courseId     String       @map("course_id") @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  instructorId String       @map("instructor_id") @db.Uuid
  vehicleId    String?      @map("vehicle_id") @db.Uuid
  lessonType   LessonType   @map("lesson_type")
  startTime    DateTime     @map("start_time")
  endTime      DateTime     @map("end_time")
  status       LessonStatus @default(SCHEDULED) @map("status")
  createdAt    DateTime     @default(now()) @map("created_at")
  deletedAt    DateTime?    @map("deleted_at")

  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentProfile    StudentProfile    @relation("StudentLessons", fields: [studentId], references: [id])
  instructorProfile InstructorProfile @relation("InstructorLessons", fields: [instructorId], references: [id])
  vehicle           Vehicle?          @relation("VehicleLessons", fields: [vehicleId], references: [id])
  lessonRating      LessonRating?     @relation("LessonToRating")

  @@index([instructorId, startTime], name: "idx_lessons_instructor_id_start_time")
  @@index([vehicleId, startTime], name: "idx_lessons_vehicle_id_start_time")
  @@index([studentId, startTime], name: "idx_lessons_student_id_start_time")
  @@map("lessons")
}

model InstructorWorkingHoursDefault {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time
  createdAt    DateTime @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, dayOfWeek], name: "uq_instructor_working_hours_default_instructor_id_day_of_week")
  @@map("instructor_working_hours_default")
}

model InstructorWorkingHours {
  id           String    @id @default(uuid()) @map("id") @db.Uuid
  instructorId String    @map("instructor_id") @db.Uuid
  date         DateTime  @map("date") @db.Date
  startTime    DateTime? @map("start_time") @db.Time
  endTime      DateTime? @map("end_time") @db.Time
  isDayOff     Boolean   @default(false) @map("is_day_off")
  createdAt    DateTime  @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, date], name: "uq_instructor_working_hours_instructor_id_date")
  @@map("instructor_working_hours")
}

model InstructorTimeBlock {
  id           String                  @id @default(uuid()) @map("id") @db.Uuid
  instructorId String                  @map("instructor_id") @db.Uuid
  schoolId     String?                 @map("school_id") @db.Uuid
  startTime    DateTime                @map("start_time")
  endTime      DateTime                @map("end_time")
  type         InstructorTimeBlockType @map("type")
  createdAt    DateTime                @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  school     DrivingSchool?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([instructorId, startTime], name: "idx_instructor_time_blocks_instructor_start")
  @@map("instructor_time_blocks")
}

model InstructorLeave {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId, startDate, endDate], name: "idx_instructor_leaves_instructor_range")
  @@map("instructor_leaves")
}

model InstructorEvent {
  id           String      @id @default(uuid()) @map("id") @db.Uuid
  instructorId String      @map("instructor_id") @db.Uuid
  schoolId     String      @map("school_id") @db.Uuid
  courseId     String?     @map("course_id") @db.Uuid
  type         EventType   @map("type")
  startTime    DateTime    @map("start_time")
  endTime      DateTime    @map("end_time")
  vehicleId    String?     @map("vehicle_id") @db.Uuid
  capacity     Int?        @map("capacity")
  isActive     Boolean     @default(true) @map("is_active")
  status       EventStatus @default(PLANNED) @map("status")
  createdAt    DateTime    @default(now()) @map("created_at")

  instructor   InstructorProfile  @relation("InstructorEvents", fields: [instructorId], references: [id], onDelete: Cascade)
  school       DrivingSchool      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?           @relation("VehicleEvents", fields: [vehicleId], references: [id], onDelete: SetNull)
  participants EventParticipant[]

  @@index([instructorId, startTime], name: "idx_instructor_events_instructor_id_start_time")
  @@index([schoolId, startTime], name: "idx_instructor_events_school_id_start_time")
  @@index([vehicleId, startTime], name: "idx_instructor_events_vehicle_id_start_time")
  @@index([courseId], name: "idx_instructor_events_course_id")
  @@map("instructor_events")
}

model EventParticipant {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event   InstructorEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId], name: "uq_event_participants_event_student")
  @@index([studentId], name: "idx_event_participants_student_id")
  @@map("event_participants")
}

model PaymentPlan {
  id                   String          @id @default(uuid()) @map("id") @db.Uuid
  courseId             String          @map("course_id") @db.Uuid
  totalAmount          Decimal         @map("total_amount")
  currency             String          @default("PLN")
  type                 PaymentPlanType @map("type")
  numberOfInstallments Int?            @map("number_of_installments")
  status               String          @default("active") @map("status")
  createdAt            DateTime        @default(now()) @map("created_at")

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("payment_plans")
}

model Payment {
  id            String        @id @default(uuid()) @map("id") @db.Uuid
  paymentPlanId String        @map("payment_plan_id") @db.Uuid
  amount        Decimal       @map("amount")
  dueDate       DateTime?     @map("due_date") @db.Date
  paidAt        DateTime?     @map("paid_at")
  status        PaymentStatus @default(PENDING) @map("status")
  method        String?       @map("method")
  createdAt     DateTime      @default(now()) @map("created_at")

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId, status], name: "idx_payments_payment_plan_id_status")
  @@map("payments")
}

model LessonRating {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  rating       Int      @map("rating")
  comment      String?  @map("comment")
  createdAt    DateTime @default(now()) @map("created_at")

  lesson     Lesson            @relation("LessonToRating", fields: [lessonId], references: [id], onDelete: Cascade)
  student    StudentProfile    @relation("StudentLessonRatings", fields: [studentId], references: [id])
  instructor InstructorProfile @relation("InstructorLessonRatings", fields: [instructorId], references: [id])

  @@index([instructorId, createdAt], name: "idx_lesson_ratings_instructor_id_created_at")
  @@index([studentId, createdAt], name: "idx_lesson_ratings_student_id_created_at")
  @@map("lesson_ratings")
}
