generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  MANAGER
  ADMIN
}

enum LessonType {
  THEORY
  PRACTICE
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum PaymentPlanType {
  FULL
  INSTALLMENTS
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum CourseKind {
  THEORY_GROUP
  PRACTICAL
  EXTRA
}

enum CourseParticipantStatus {
  ACTIVE
  FINISHED
}

enum VehicleAvailabilityStatus {
  ACTIVE
  UNAVAILABLE
}

enum InstructorTimeBlockType {
  BREAK
  MEETING
  OTHER
}

enum EventType {
  DRIVE
  THEORY
}

enum EventStatus {
  PLANNED
  DONE
  NO_SHOW
  CANCELLED
}

// NOTE: DB-level constraints (EXCLUDE, CHECK) must be added as raw SQL migrations.
// See context/db_constraints.md for recommended SQL snippets.

model User {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique @map("email")
  phone     String?   @map("phone")
  role      Role      @map("role")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  defaultOskId String? @map("default_osk_id") @db.Uuid

  settings            UserSettings?
  profile             UserProfile?
  instructorProfile   InstructorProfile?
  studentProfile      StudentProfile?
  drivingSchoolsOwned DrivingSchool[]    @relation("OwnerDrivingSchools")
  defaultOsk          DrivingSchool?     @relation("DefaultOSK", fields: [defaultOskId], references: [id])

  @@index([role], name: "idx_users_role")
  @@map("users")
}

model UserSettings {
  id        String    @id @default(uuid()) @map("id") @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  themeMode String?   @default("light") @map("theme_mode")
  language  String?   @default("pl")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime? @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserProfile {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  avatarUrl String?  @map("avatar_url")
  bio       String?  @map("bio")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model DrivingSchool {
  id               String    @id @default(uuid()) @map("id") @db.Uuid
  name             String    @map("name")
  city             String?   @map("city")
  address          String?   @map("address")
  ownerId          String    @map("owner_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")
  defaultVehicleId String?   @map("default_vehicle_id") @db.Uuid

  owner                User                  @relation("OwnerDrivingSchools", fields: [ownerId], references: [id])
  defaultVehicle       Vehicle?              @relation("SchoolDefaultVehicle", fields: [defaultVehicleId], references: [id], onDelete: SetNull)
  defaultForUsers      User[]                @relation("DefaultOSK")
  settings             SchoolSettings?
  vehicles             Vehicle[]
  courses              Course[]
  instructorSchools    InstructorSchool[]
  studentSchools       StudentSchool[]
  instructorTimeBlocks InstructorTimeBlock[]

  @@map("driving_schools")
}

model SchoolSettings {
  id                         String       @id @default(uuid()) @map("id") @db.Uuid
  schoolId                   String       @unique @map("school_id") @db.Uuid
  workingDaysMask            Int          @default(62) @map("working_days_mask")
  workingHoursStart          DateTime     @default(dbgenerated("'08:00'::time")) @map("working_hours_start") @db.Time
  workingHoursEnd            DateTime     @default(dbgenerated("'18:00'::time")) @map("working_hours_end") @db.Time
  slotDurationMinutes        Int          @default(60) @map("slot_duration_minutes")
  slotMustStartFullHour      Boolean      @default(true) @map("slot_must_start_full_hour")
  practiceMinDurationMinutes Int          @default(60) @map("practice_min_duration_minutes")
  practiceMaxDurationMinutes Int          @default(120) @map("practice_max_duration_minutes")
  theoryMinDurationMinutes   Int          @default(45) @map("theory_min_duration_minutes")
  theoryMaxDurationMinutes   Int          @default(90) @map("theory_max_duration_minutes")
  bookingMaxDaysAhead        Int          @default(30) @map("booking_max_days_ahead")
  enabledCourseKinds         CourseKind[] @default([]) @map("enabled_course_kinds")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime?    @map("updated_at")

  school             DrivingSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  offeredCourseTypes CourseType[]  @relation("SchoolSettingsOfferedCourseTypes")

  @@map("school_settings")
}

model InstructorProfile {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  licenseNumber   String   @map("license_number")
  experienceYears Int?     @map("experience_years")
  qualifications  String?  @map("qualifications") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  user                User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instructorSchools   InstructorSchool[]
  workingHoursDefault InstructorWorkingHoursDefault[]
  workingHours        InstructorWorkingHours[]
  timeBlocks          InstructorTimeBlock[]
  leaves              InstructorLeave[]
  lessons             Lesson[]                        @relation("InstructorLessons")
  lessonRatings       LessonRating[]                  @relation("InstructorLessonRatings")
  assignedCourses     Course[]                        @relation("CourseAssignedInstructor")
  instructorEvents    InstructorEvent[]               @relation("InstructorEvents")
  qualifiedCourseTypes CourseType[]                   @relation("InstructorQualifiedCourseTypes")

  @@map("instructor_profiles")
}

model StudentProfile {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  pesel     String?  @unique @map("pesel")
  pkkNumber String?  @unique @map("pkk_number") @db.VarChar(20)
  notes     String?  @map("notes")
  createdAt DateTime @default(now()) @map("created_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentSchools     StudentSchool[]
  courseParticipants CourseParticipant[]
  lessons            Lesson[]            @relation("StudentLessons")
  lessonRatings      LessonRating[]      @relation("StudentLessonRatings")
  eventParticipants  EventParticipant[]

  @@map("student_profiles")
}

model InstructorSchool {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  school     DrivingSchool     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([instructorId, schoolId], name: "uq_instructor_schools_instructor_id_school_id")
  @@map("instructor_schools")
}

model StudentSchool {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  school  DrivingSchool  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolId], name: "uq_student_schools_student_id_school_id")
  @@map("student_schools")
}

model Vehicle {
  id                 String                    @id @default(uuid()) @map("id") @db.Uuid
  schoolId           String                    @map("school_id") @db.Uuid
  name               String                    @map("name")
  registrationNumber String                    @map("registration_number")
  inspectionDate     DateTime?                 @map("inspection_date")
  insuranceDate      DateTime?                 @map("insurance_date")
  brand              String?                   @map("brand")
  model              String?                   @map("model")
  photoUrl           String?                   @map("photo_url")
  modelYear          Int?                      @map("model_year")
  mileageKm          Int?                      @map("mileage_km")
  note               String?                   @map("note") @db.Text
  availabilityStatus VehicleAvailabilityStatus @default(ACTIVE) @map("availability_status")
  isActive           Boolean                   @default(true) @map("is_active")
  createdAt          DateTime                  @default(now()) @map("created_at")

  school            DrivingSchool     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  defaultForSchools DrivingSchool[]   @relation("SchoolDefaultVehicle")
  lessons           Lesson[]          @relation("VehicleLessons")
  instructorEvents  InstructorEvent[] @relation("VehicleEvents")

  @@unique([schoolId, registrationNumber], name: "uq_vehicles_school_id_registration_number")
  @@map("vehicles")
}

model CourseType {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  code      String   @unique @map("code")
  name      String   @map("name")
  createdAt DateTime @default(now()) @map("created_at")

  schoolSettingsOffered SchoolSettings[]      @relation("SchoolSettingsOfferedCourseTypes")
  qualifiedInstructors InstructorProfile[] @relation("InstructorQualifiedCourseTypes")
  courses Course[]

  @@map("course_types")
}

model Course {
  id              String     @id @default(uuid()) @map("id") @db.Uuid
  schoolId        String     @map("school_id") @db.Uuid
  name            String     @map("name")
  category        String     @map("category")
  courseTypeId    String     @map("course_type_id") @db.Uuid
  kind            CourseKind @map("kind")
  totalHours      Int        @map("total_hours")
  capacity        Int?       @map("capacity")
  theoryStartDate DateTime?  @map("theory_start_date") @db.Date
  theoryEndDate   DateTime?  @map("theory_end_date") @db.Date
  instructorId    String?    @map("instructor_id") @db.Uuid
  status          String     @default("active") @map("status")
  createdAt       DateTime   @default(now()) @map("created_at")
  deletedAt       DateTime?  @map("deleted_at")

  school           DrivingSchool       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  courseType       CourseType          @relation(fields: [courseTypeId], references: [id])
  instructor       InstructorProfile?  @relation("CourseAssignedInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  participants     CourseParticipant[]
  paymentPlans     PaymentPlan[]
  lessons          Lesson[]
  instructorEvents InstructorEvent[]

  @@index([courseTypeId], name: "idx_courses_course_type_id")
  @@map("courses")
}

model CourseParticipant {
  id        String                  @id @default(uuid()) @map("id") @db.Uuid
  courseId  String                  @map("course_id") @db.Uuid
  studentId String                  @map("student_id") @db.Uuid
  status    CourseParticipantStatus @default(ACTIVE) @map("status")
  createdAt DateTime                @default(now()) @map("created_at")

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId], name: "uq_course_participants_course_id_student_id")
  @@index([studentId], name: "idx_course_participants_student_id")
  @@map("course_participants")
}

model Lesson {
  id           String       @id @default(uuid()) @map("id") @db.Uuid
  courseId     String       @map("course_id") @db.Uuid
  studentId    String       @map("student_id") @db.Uuid
  instructorId String       @map("instructor_id") @db.Uuid
  vehicleId    String?      @map("vehicle_id") @db.Uuid
  lessonType   LessonType   @map("lesson_type")
  startTime    DateTime     @map("start_time")
  endTime      DateTime     @map("end_time")
  status       LessonStatus @default(SCHEDULED) @map("status")
  createdAt    DateTime     @default(now()) @map("created_at")
  deletedAt    DateTime?    @map("deleted_at")

  course            Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentProfile    StudentProfile    @relation("StudentLessons", fields: [studentId], references: [id])
  instructorProfile InstructorProfile @relation("InstructorLessons", fields: [instructorId], references: [id])
  vehicle           Vehicle?          @relation("VehicleLessons", fields: [vehicleId], references: [id])
  lessonRating      LessonRating?     @relation("LessonToRating")

  @@index([instructorId, startTime], name: "idx_lessons_instructor_id_start_time")
  @@index([vehicleId, startTime], name: "idx_lessons_vehicle_id_start_time")
  @@index([studentId, startTime], name: "idx_lessons_student_id_start_time")
  @@map("lessons")
}

model InstructorWorkingHoursDefault {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  startTime    DateTime @map("start_time") @db.Time
  endTime      DateTime @map("end_time") @db.Time
  createdAt    DateTime @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, dayOfWeek], name: "uq_instructor_working_hours_default_instructor_id_day_of_week")
  @@map("instructor_working_hours_default")
}

model InstructorWorkingHours {
  id           String    @id @default(uuid()) @map("id") @db.Uuid
  instructorId String    @map("instructor_id") @db.Uuid
  date         DateTime  @map("date") @db.Date
  startTime    DateTime? @map("start_time") @db.Time
  endTime      DateTime? @map("end_time") @db.Time
  isDayOff     Boolean   @default(false) @map("is_day_off")
  createdAt    DateTime  @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([instructorId, date], name: "uq_instructor_working_hours_instructor_id_date")
  @@map("instructor_working_hours")
}

model InstructorTimeBlock {
  id           String                  @id @default(uuid()) @map("id") @db.Uuid
  instructorId String                  @map("instructor_id") @db.Uuid
  schoolId     String?                 @map("school_id") @db.Uuid
  startTime    DateTime                @map("start_time")
  endTime      DateTime                @map("end_time")
  type         InstructorTimeBlockType @map("type")
  createdAt    DateTime                @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  school     DrivingSchool?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("instructor_time_blocks")
}

model InstructorLeave {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  instructor InstructorProfile @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@map("instructor_leaves")
}

model InstructorEvent {
  id           String      @id @default(uuid()) @map("id") @db.Uuid
  instructorId String      @map("instructor_id") @db.Uuid
  courseId     String?     @map("course_id") @db.Uuid
  type         EventType   @map("type")
  startTime    DateTime    @map("start_time")
  endTime      DateTime    @map("end_time")
  vehicleId    String?     @map("vehicle_id") @db.Uuid
  capacity     Int?        @map("capacity")
  isActive     Boolean     @default(true) @map("is_active")
  status       EventStatus @default(PLANNED) @map("status")
  createdAt    DateTime    @default(now()) @map("created_at")

  instructor   InstructorProfile  @relation("InstructorEvents", fields: [instructorId], references: [id], onDelete: Cascade)
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  vehicle      Vehicle?           @relation("VehicleEvents", fields: [vehicleId], references: [id], onDelete: SetNull)
  participants EventParticipant[]

  @@index([instructorId, startTime], name: "idx_instructor_events_instructor_id_start_time")
  @@index([vehicleId, startTime], name: "idx_instructor_events_vehicle_id_start_time")
  @@index([courseId], name: "idx_instructor_events_course_id")
  @@map("instructor_events")
}

model EventParticipant {
  id        String   @id @default(uuid()) @map("id") @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  event   InstructorEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId], name: "uq_event_participants_event_student")
  @@index([studentId], name: "idx_event_participants_student_id")
  @@map("event_participants")
}

model PaymentPlan {
  id                   String          @id @default(uuid()) @map("id") @db.Uuid
  courseId             String          @map("course_id") @db.Uuid
  totalAmount          Decimal         @map("total_amount")
  currency             String          @default("PLN")
  type                 PaymentPlanType @map("type")
  numberOfInstallments Int?            @map("number_of_installments")
  status               String          @default("active") @map("status")
  createdAt            DateTime        @default(now()) @map("created_at")

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@map("payment_plans")
}

model Payment {
  id            String        @id @default(uuid()) @map("id") @db.Uuid
  paymentPlanId String        @map("payment_plan_id") @db.Uuid
  amount        Decimal       @map("amount")
  dueDate       DateTime?     @map("due_date") @db.Date
  paidAt        DateTime?     @map("paid_at")
  status        PaymentStatus @default(PENDING) @map("status")
  method        String?       @map("method")
  createdAt     DateTime      @default(now()) @map("created_at")

  paymentPlan PaymentPlan @relation(fields: [paymentPlanId], references: [id], onDelete: Cascade)

  @@index([paymentPlanId, status], name: "idx_payments_payment_plan_id_status")
  @@map("payments")
}

model LessonRating {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  lessonId     String   @unique @map("lesson_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  instructorId String   @map("instructor_id") @db.Uuid
  rating       Int      @map("rating")
  comment      String?  @map("comment")
  createdAt    DateTime @default(now()) @map("created_at")

  lesson     Lesson            @relation("LessonToRating", fields: [lessonId], references: [id], onDelete: Cascade)
  student    StudentProfile    @relation("StudentLessonRatings", fields: [studentId], references: [id])
  instructor InstructorProfile @relation("InstructorLessonRatings", fields: [instructorId], references: [id])

  @@map("lesson_ratings")
}
